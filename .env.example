# NIVAS Campus Management Platform - Environment Template
# Copy this file to .env and configure local values.
# (.env is automatically ignored by Git to prevent leaking secrets)

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=localhost

# Security & Secrets (Override in your local .env)
JWT_SECRET=your_secret_signing_key_here
SESSION_TIMEOUT_MINUTES=60

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=15

# Frontend Dev API Target
VITE_API_BASE_URL=http://localhost:8080/api
